# Runtime da aplicação. Em produção, prefira a URL pooled do provedor.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Prisma CLI, migrations e bootstrap. Use uma URL direta quando disponível.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Usadas somente pelo seed local (npm run db:seed).
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="professor@example.com"
INITIAL_ADMIN_PASSWORD="defina-uma-senha-local-segura"

# Segredo estável e aleatório com pelo menos 32 caracteres.
SESSION_SECRET="substitua-por-um-segredo-aleatorio-de-producao"
